{
  "name": "lam-moc-thao-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Phần mềm quản trị Công ty TNHH Lâm Mộc Thảo",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
