# Chạy trên máy cá nhân (npm run dev): chuỗi kết nối PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lmt_dev"

# Triển khai bằng Docker Compose (docs/TRIEN-KHAI.md)
POSTGRES_PASSWORD=doi-mat-khau-manh-o-day
# true khi truy cập qua HTTPS (khuyến nghị). Đặt false nếu chỉ dùng trong mạng nội bộ qua HTTP.
COOKIE_SECURE=true
# Mật khẩu ban đầu cho 05 tài khoản khi chạy db:seed. Bỏ trống: hệ thống sinh ngẫu nhiên và in ra màn hình.
SEED_PASSWORD=
APP_BIND=127.0.0.1
APP_PORT=3000
